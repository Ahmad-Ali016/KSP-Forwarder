<?xml version="1.0" encoding="utf-8"?>
<!--
  KPOS's Offline API is LAN/localhost-only and plain HTTP (http://127.0.0.1:18080), so cleartext
  traffic must stay permitted there, or the sale/query calls fail outright on API 28+, which
  blocks cleartext by default. Everywhere else (the KSPay backend) must use TLS; the base config
  below denies cleartext for every other domain.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
